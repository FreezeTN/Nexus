{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["Player", "Dungeon Master", "Spectator", "Tester"] },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "tier": { "type": "string", "enum": ["free", "tester", "developer", "supporter", "adventurer", "dungeon_master"] },
        "tierExpiresAt": { "type": "string", "maxLength": 64 },
        "paypalTxId": { "type": "string", "maxLength": 128 },
        "paypalEmail": { "type": "string", "maxLength": 256 },
        "isLifetime": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "displayName"]
    },
    "Character": {
      "title": "Character Sheet",
      "description": "Player character sheet data including stats, inventory, and spells",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "edition": { "type": "string", "maxLength": 32 },
        "level": { "type": "number" },
        "characterClass": { "type": "string", "maxLength": 64 },
        "race": { "type": "string", "maxLength": 64 },
        "data": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "name"]
    },
    "GameSession": {
      "title": "Live Game Session",
      "description": "Multiplayer live campaign room state, party members, and ambience",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 16 },
        "name": { "type": "string", "maxLength": 128 },
        "dmUid": { "type": "string", "maxLength": 128 },
        "dmName": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "paused", "closed"] },
        "members": { "type": "array" },
        "activeCharacterIds": { "type": "array" },
        "activeAmbience": { "type": "object" },
        "optionalRules": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["code", "dmUid", "status"]
    },
    "VoicePeer": {
      "title": "Voice Chat Peer",
      "description": "WebRTC voice status and signaling peer state",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "isMuted": { "type": "boolean" },
        "isDeafened": { "type": "boolean" },
        "isSpeaking": { "type": "boolean" },
        "characterName": { "type": "string", "maxLength": 128 },
        "lastSeen": { "type": "number" }
      },
      "required": ["uid", "displayName"]
    },
    "VoiceSignal": {
      "title": "Voice Signaling Message",
      "description": "WebRTC handshake signal payload between peers",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "maxLength": 128 },
        "receiverUid": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["offer", "answer", "candidate"] },
        "payload": { "type": "object" },
        "timestamp": { "type": "number" }
      },
      "required": ["senderUid", "receiverUid", "type"]
    },
    "CharacterPresence": {
      "title": "Character Presence Lock",
      "description": "Real-time presence and concurrency lock for character editing",
      "type": "object",
      "properties": {
        "characterId": { "type": "string", "maxLength": 128 },
        "sessionCode": { "type": "string", "maxLength": 32 },
        "activeUserId": { "type": "string", "maxLength": 128 },
        "activeUserName": { "type": "string", "maxLength": 128 },
        "activeUserRole": { "type": "string", "maxLength": 64 },
        "dmActive": { "type": "boolean" },
        "dmUserId": { "type": "string", "maxLength": 128 },
        "dmUserName": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["characterId"]
    },
    "CampaignSave": {
      "title": "Campaign Save File",
      "description": "Full serialized save checkpoint of a tabletop campaign",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "sessionCode": { "type": "string", "maxLength": 32 },
        "hostUid": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 128 },
        "savedAt": { "type": "string", "maxLength": 64 },
        "edition": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "hostUid", "savedAt"]
    },
    "Party": {
      "title": "Adventuring Party",
      "description": "Party grouping for campaigns and shared campaigns",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "dmId": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "memberIds": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "dmId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile records with strict owner-only update and auth-verified access"
    },
    "/characters/{characterId}": {
      "schema": { "$ref": "#/entities/Character" },
      "description": "Character sheets isolated by ownerId"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/GameSession" },
      "description": "Live tabletop sessions created by DM and joined by players"
    },
    "/sessions/{sessionId}/voice_peers/{peerId}": {
      "schema": { "$ref": "#/entities/VoicePeer" },
      "description": "Active voice chat peer participants"
    },
    "/sessions/{sessionId}/voice_signals/{signalId}": {
      "schema": { "$ref": "#/entities/VoiceSignal" },
      "description": "Ephemeral WebRTC signaling queue"
    },
    "/presence/{characterId}": {
      "schema": { "$ref": "#/entities/CharacterPresence" },
      "description": "Live character lock and presence indicator"
    },
    "/campaign_saves/{saveId}": {
      "schema": { "$ref": "#/entities/CampaignSave" },
      "description": "Exported and cloud-saved campaign snapshots owned by the host DM"
    },
    "/parties/{partyId}": {
      "schema": { "$ref": "#/entities/Party" },
      "description": "Adventuring parties created by DM"
    }
  }
}
